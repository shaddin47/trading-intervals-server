# ── Python ───────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
*.egg

# ── Secrets / environment ────────────────────────────────────────────────────
.env
# Keep the example so new devs know what's needed
!.env.example

# ── Runtime cache (generated by the app — never commit) ──────────────────────
cache/
# SQLite config DB is runtime state, not source
# (seed it via /api/admin/migrate-yaml on first deploy)

# ── Frontend build output ────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ── VS Code ──────────────────────────────────────────────────────────────────
# Keep launch.json (useful for all devs); ignore personal settings
.vscode/settings.json
.vscode/extensions.json

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
