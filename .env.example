# ============================================================
# Trading Intervals Monitor — environment configuration
# Copy to .env and fill in real values.
# Never commit .env to version control.
# ============================================================

# ── Production SQL Server ────────────────────────────────────
DB_HOST=prod-sql-server.cqginc.com
DB_NAME=CQGData
DB_USER=svc_trading_intervals
DB_PASSWORD=your-prod-password
DB_PORT=1433
# DB_DRIVER=ODBC Driver 18 for SQL Server   # default; same name on Linux and Windows

# ── Stage SQL Server ─────────────────────────────────────────
# Only set fields that DIFFER from prod.
# Leave blank to inherit the prod value automatically.
#
# Same server, different database:
STAGE_DB_NAME=CQGDataStage
#
# Completely separate server:
# STAGE_DB_HOST=stage-sql.cqginc.com
# STAGE_DB_NAME=CQGDataStage
# STAGE_DB_USER=svc_trading_intervals_stage
# STAGE_DB_PASSWORD=your-stage-password
STAGE_DB_HOST=
STAGE_DB_USER=
STAGE_DB_PASSWORD=
STAGE_DB_PORT=

# ── Task XML archive ─────────────────────────────────────────
# Linux  (CIFS/Samba mount):
TASK_ARCHIVE_PATH=/mnt/smb/dgwnas/archive/stasks_xml
#
# Windows (UNC path — use forward slashes or double backslashes):
# TASK_ARCHIVE_PATH=\\dgwnas.cqginc.com\Archive\stasks_xml
#
# Windows (mapped drive):
# TASK_ARCHIVE_PATH=Z:\stasks_xml

# ── GitLab (Linux messenger cron inventory) ──────────────────
GITLAB_URL=https://git.at.cqg
GITLAB_TOKEN=glpat-xxxx
GITLAB_PROJECT=inventory/gateway
GITLAB_REF=master

# ── Cache & refresh ──────────────────────────────────────────
CACHE_DIR=./cache
REFRESH_INTERVAL_SECS=7200

# ── Application ──────────────────────────────────────────────
APP_ENV=prod
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR
